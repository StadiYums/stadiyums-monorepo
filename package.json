{
  "name": "stadiyums-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:landing": "pnpm --filter @stadiyums/landing dev",
    "dev:fan": "pnpm --filter @stadiyums/fan dev",
    "dev:runner": "pnpm --filter @stadiyums/runner dev",
    "dev:admin": "pnpm --filter @stadiyums/admin dev"
  },
  "dependencies": {
    "@stadiyums/types": "workspace:*",
    "@stadiyums/ui": "workspace:*",
    "convex": "^1.32.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.1.0",
    "eslint": "^9",
    "turbo": "^2.5.4",
    "typescript": "^5"
  }
}
